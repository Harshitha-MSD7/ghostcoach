    {
      "id": "tests_detail",
      "type": "text",
      "x": 1040,
      "y": 2880,
      "width": 850,
      "height": 202.5,
      "fontSize": 18,
      "text": "7 geometry tests: known angles; translation/scale invariance;\nmirror reversal/labels; mirror match; low confidence; missing\nanchors; direction of feedback. Synthetic fixtures only.\n\n5 API tests: health, bad image, oversized upload, busy lock,\nand response contract using explicitly stubbed inference.\n\n1 preprocessing test: actual VitPose affine preprocessing;\nfinite tensor + expected shape, no model weights required.",
      "strokeColor": "#374151",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 1000003,
      "version": 1,
      "versionNonce": 1020003,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "frameId": null,
      "updated": 1,
      "backgroundColor": "transparent",
      "originalText": "7 geometry tests: known angles; translation/scale invariance;\nmirror reversal/labels; mirror match; low confidence; missing\nanchors; direction of feedback. Synthetic fixtures only.\n\n5 API tests: health, bad image, oversized upload, busy lock,\nand response contract using explicitly stubbed inference.\n\n1 preprocessing test: actual VitPose affine preprocessing;\nfinite tensor + expected shape, no model weights required.",
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "tests_cli",
      "type": "text",
      "x": 1040,
      "y": 3100,
      "width": 850,
      "height": 157.5,
      "fontSize": 18,
      "text": "RUN / INSPECT\npython -m pytest backend/tests -q\npython -m backend.proof photo.jpg --output artifacts/proof\nProof writes annotated .jpg + landmark .json and timings.\nBrowser checks covered responsive layout, help/Escape,\nequal studio dimensions and reset of mirror state.\nThese checks do not establish model accuracy or safety.",
      "strokeColor": "#64748b",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 1000004,
      "version": 1,
      "versionNonce": 1020004,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "frameId": null,
      "updated": 1,
      "backgroundColor": "transparent",
      "originalText": "RUN / INSPECT\npython -m pytest backend/tests -q\npython -m backend.proof photo.jpg --output artifacts/proof\nProof writes annotated .jpg + landmark .json and timings.\nBrowser checks covered responsive layout, help/Escape,\nequal studio dimensions and reset of mirror state.\nThese checks do not establish model accuracy or safety.",
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
