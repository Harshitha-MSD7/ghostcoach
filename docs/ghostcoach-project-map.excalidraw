    {
      "id": "api_validation",
      "type": "text",
      "x": 1040,
      "y": 1020,
      "width": 855,
      "height": 157.5,
      "fontSize": 18,
      "text": "GUARDS / ERROR PATHS\n400: invalid or undecodable image.\n413: selected image > 8 MiB or > 16 million pixels.\n409: another comparison holds the nonblocking engine lock.\n422: no person / multiple people (or request validation).\n503: unexpected model/inference failure; no fake output.\nPillow applies EXIF orientation and converts to RGB.",
      "strokeColor": "#374151",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 300011,
      "version": 1,
      "versionNonce": 320011,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "frameId": null,
      "updated": 1,
      "backgroundColor": "transparent",
      "originalText": "GUARDS / ERROR PATHS\n400: invalid or undecodable image.\n413: selected image > 8 MiB or > 16 million pixels.\n409: another comparison holds the nonblocking engine lock.\n422: no person / multiple people (or request validation).\n503: unexpected model/inference failure; no fake output.\nPillow applies EXIF orientation and converts to RGB.",
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "api_health",
      "type": "text",
      "x": 1040,
      "y": 1215,
      "width": 855,
      "height": 157.5,
      "fontSize": 18,
      "text": "GET /health ← frontend polls /api/health every 5 seconds\nstatus, model_status, device, load_seconds, last_error, models\nModel states: not_loaded → loading → ready, or error.\nlast_error also records inference failure; success clears it.\nLock is released in finally, including exceptions.\nCORS: localhost:5173 and 127.0.0.1:5173; GET + POST.\nNo authentication, request history, or database.",
      "strokeColor": "#64748b",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 300012,
