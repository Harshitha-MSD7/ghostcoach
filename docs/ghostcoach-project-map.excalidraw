    {
      "id": "browser_limits",
      "type": "text",
      "x": 60,
      "y": 947,
      "width": 860,
      "height": 135,
      "fontSize": 18,
      "text": "INPUT RULES\n• Video or image MIME; client limit: 200 MB per file.\n• Drag/drop, upload, replace, native video controls.\n• Independent timestamp sliders; 0.04-second increments.\n• Capture longest side ≤ 1600 px; JPEG quality 0.92.\n• No cropping; equal studio panels; media uses contain.",
      "strokeColor": "#374151",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 200010,
      "version": 1,
      "versionNonce": 220010,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "frameId": null,
      "updated": 1,
      "backgroundColor": "transparent",
      "originalText": "INPUT RULES\n• Video or image MIME; client limit: 200 MB per file.\n• Drag/drop, upload, replace, native video controls.\n• Independent timestamp sliders; 0.04-second increments.\n• Capture longest side ≤ 1600 px; JPEG quality 0.92.\n• No cropping; equal studio panels; media uses contain.",
      "fontFamily": 3,
