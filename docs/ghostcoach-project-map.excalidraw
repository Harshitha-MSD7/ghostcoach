    {
      "id": "ops_commands",
      "type": "text",
      "x": 80,
      "y": 2815,
      "width": 805,
      "height": 202.5,
      "fontSize": 18,
      "text": "# From ghostcoach/; Python 3.12 recommended\npython -m venv .venv\n.\\.venv\\Scripts\\Activate.ps1\npython -m pip install -r backend/requirements.txt\nnpm install\n# Separate terminals, with .venv active for Python\npython -m uvicorn backend.main:app --port 8000\nnpm run dev\n# Windows: npm.cmd if PowerShell blocks npm.ps1",
      "strokeColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 900004,
      "version": 1,
      "versionNonce": 920004,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "frameId": null,
      "updated": 1,
      "backgroundColor": "transparent",
      "originalText": "# From ghostcoach/; Python 3.12 recommended\npython -m venv .venv\n.\\.venv\\Scripts\\Activate.ps1\npython -m pip install -r backend/requirements.txt\nnpm install\n# Separate terminals, with .venv active for Python\npython -m uvicorn backend.main:app --port 8000\nnpm run dev\n# Windows: npm.cmd if PowerShell blocks npm.ps1",
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "ops_stack",
      "type": "text",
      "x": 60,
      "y": 3060,
      "width": 850,
      "height": 170,
      "fontSize": 17,
      "text": "JS: React / React DOM, TypeScript, Vite, Phosphor icons.\nPython: FastAPI, Uvicorn, python-multipart, Pillow, NumPy,\nPyTorch, torchvision, transformers, SciPy; pytest + httpx.\n\nBuild: npm run build (tsc -b && vite build).\nFirst inference may download model weights; later runs cache.\nBind local server to 127.0.0.1. This is a development setup.\nVite's /api proxy is configured for dev, not production hosting.",
      "strokeColor": "#374151",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 900005,
      "version": 1,
      "versionNonce": 920005,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "frameId": null,
      "updated": 1,
      "backgroundColor": "transparent",
      "originalText": "JS: React / React DOM, TypeScript, Vite, Phosphor icons.\nPython: FastAPI, Uvicorn, python-multipart, Pillow, NumPy,\nPyTorch, torchvision, transformers, SciPy; pytest + httpx.\n\nBuild: npm run build (tsc -b && vite build).\nFirst inference may download model weights; later runs cache.\nBind local server to 127.0.0.1. This is a development setup.\nVite's /api proxy is configured for dev, not production hosting.",
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
