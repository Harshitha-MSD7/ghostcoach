    {
      "id": "limits_current",
      "type": "text",
      "x": 2010,
      "y": 2795,
      "width": 855,
      "height": 202.5,
      "fontSize": 18,
      "text": "CURRENT PRODUCT BOUNDARY\nSelected frames only; no automatic temporal alignment.\nSingle person per frame; upper-body angle measurements.\nSkeleton can show legs, but knee/hip angles are not measured.\nNo live camera stream, full-routine scoring, or 3D analysis.\nNo accounts, saved history, database, or authentication.\nNo medical claims or validated coaching/safety score.\nNo LLM, voice assistant, wearable device, GPS, or caregiver app.\nInternet needed for initial model downloads, not a cloud LLM.",
      "strokeColor": "#374151",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 1100002,
      "version": 1,
      "versionNonce": 1120002,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "frameId": null,
      "updated": 1,
      "backgroundColor": "transparent",
      "originalText": "CURRENT PRODUCT BOUNDARY\nSelected frames only; no automatic temporal alignment.\nSingle person per frame; upper-body angle measurements.\nSkeleton can show legs, but knee/hip angles are not measured.\nNo live camera stream, full-routine scoring, or 3D analysis.\nNo accounts, saved history, database, or authentication.\nNo medical claims or validated coaching/safety score.\nNo LLM, voice assistant, wearable device, GPS, or caregiver app.\nInternet needed for initial model downloads, not a cloud LLM.",
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "limits_future",
      "type": "text",
      "x": 2010,
      "y": 3015,
      "width": 855,
      "height": 180,
      "fontSize": 18,
      "text": "POSSIBLE NEXT STEPS — NOT IMPLEMENTED\n• New attempt: preserve reference, replace only the attempt.\n• Previous/next-frame controls for finer video alignment.\n• Elapsed time + clearer model-loading progress.\n• Evaluate on varied poses, framing, occlusion and lighting.\n• Production serving, access control and resource limits.\n\nAlready implemented: largest differences are shown first.",
      "strokeColor": "#64748b",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 1100003,
      "version": 1,
      "versionNonce": 1120003,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "frameId": null,
      "updated": 1,
      "backgroundColor": "transparent",
      "originalText": "POSSIBLE NEXT STEPS — NOT IMPLEMENTED\n• New attempt: preserve reference, replace only the attempt.\n• Previous/next-frame controls for finer video alignment.\n• Elapsed time + clearer model-loading progress.\n• Evaluate on varied poses, framing, occlusion and lighting.\n• Production serving, access control and resource limits.\n\nAlready implemented: largest differences are shown first.",
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "limits_sources",
      "type": "text",
      "x": 2010,
      "y": 3225,
      "width": 855,
      "height": 85,
      "fontSize": 17,
      "text": "SOURCE OF TRUTH\nLocal src/, backend/, tests/, package.json, requirements.txt,\nvite.config.ts and README.md inspected for this map.\nModel IDs and numerical thresholds come directly from code.",
      "strokeColor": "#64748b",
      "fillStyle": "solid",
