      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "frameId": null,
      "updated": 1,
      "backgroundColor": "transparent",
      "originalText": "GET /health ← frontend polls /api/health every 5 seconds\nstatus, model_status, device, load_seconds, last_error, models\nModel states: not_loaded → loading → ready, or error.\nlast_error also records inference failure; success clears it.\nLock is released in finally, including exceptions.\nCORS: localhost:5173 and 127.0.0.1:5173; GET + POST.\nNo authentication, request history, or database.",
      "fontFamily": 3,
